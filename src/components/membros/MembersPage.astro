---
// Members area frame: full screen, no site header/footer, and a "Voltar ao site" link in the corner.
// Used by /membros (sign-in) and /membros/demo (dashboard with fake data).
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortalMembros from '../islands/PortalMembros';

interface Props {
  demo?: boolean;
}

const { demo = false } = Astro.props;
---

<BaseLayout
  title={demo ? 'Área de Membros: demonstração' : 'Área de Membros'}
  noindex
  hideNavigation
  description="Portal de membros da Igreja dos Vales: Jornada IdeAll (rede de cursos), meu iGrupo, minhas escalas e meus dados."
>
  <section
    id="portal-membros"
    data-tom="elevado"
    aria-labelledby="portal-membros-titulo"
    class="relative flex min-h-dvh flex-col bg-surface text-ink"
  >
    <!-- No header or footer: this link is the only way back to the site. -->
    <div class="px-4 pt-4 sm:px-6 lg:px-8">
      <a
        href="/"
        class="inline-flex min-h-10 items-center gap-2 rounded-full border border-border bg-canvas px-4 text-sm font-semibold text-ink shadow-sm transition-colors hover:border-border-strong"
      >
        <span aria-hidden="true">←</span>
        Voltar ao site
      </a>
    </div>

    <div class="mx-auto flex w-full max-w-7xl flex-1 flex-col px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
      <!-- The sign-in card ("Entrar") and the dashboard ("Olá, …") already say where you are: the h1 is for screen readers. -->
      <h1 id="portal-membros-titulo" class="sr-only">Área de Membros</h1>

      <PortalMembros client:load demo={demo} />
    </div>
  </section>
</BaseLayout>
