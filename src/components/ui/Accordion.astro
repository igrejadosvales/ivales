---
import Button from './Button.astro';

// Accordion com <details>/<summary>: funciona sem JavaScript e com teclado nativo.
interface Item {
  pergunta: string;
  resposta: string;
  link?: { href: string; rotulo: string };
}

interface Props {
  itens: readonly Item[];
  titulo?: string;
}

const { itens, titulo = 'Perguntas frequentes' } = Astro.props;
---

<div class="divide-y divide-border rounded-cartao border border-border bg-canvas" role="group" aria-label={titulo}>
  {
    itens.map((item) => (
      <details class="group p-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-md font-semibold text-ink [&::-webkit-details-marker]:hidden">
          <span>{item.pergunta}</span>
          <span aria-hidden="true" class="text-2xl leading-none text-accent-text transition-transform duration-200 group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 text-ink-muted">{item.resposta}</p>
        {item.link && (
          <Button href={item.link.href} class="mt-4">{item.link.rotulo}</Button>
        )}
      </details>
    ))
  }
</div>
