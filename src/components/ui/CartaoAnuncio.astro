---
// Cartão de aviso/evento. Cada tom usa os tokens do global.css: escuro (preto), destaque (azul),
// elevado (superfície) e padrão. O link cobre o cartão inteiro (after:inset-0), mas o texto continua selecionável.
interface Props {
  titulo: string;
  href: string;
  tom?: 'escuro' | 'destaque' | 'elevado' | 'padrao';
  class?: string;
}

const { titulo, href, tom = 'elevado', class: className = '' } = Astro.props;

// O título precisa da cor explícita: a regra base de h1–h3 no global.css vence a herança do cartão.
const tons = {
  escuro: { classe: 'bg-canvas text-ink border-border', titulo: 'text-ink', link: 'text-accent-text' },
  destaque: { classe: 'bg-accent text-on-accent border-accent', titulo: 'text-on-accent', link: 'text-on-accent' },
  elevado: { classe: 'bg-surface text-ink border-border', titulo: 'text-ink', link: 'text-accent-text' },
  padrao: { classe: 'bg-canvas text-ink border-border', titulo: 'text-ink', link: 'text-accent-text' },
} as const;

const cores = tons[tom];
---

<article
  data-tom={tom === 'destaque' || tom === 'escuro' ? tom : undefined}
  class:list={[
    'group relative flex min-h-48 flex-col rounded-cartao border p-6 text-left transition-transform duration-200 hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0 h-full',
    cores.classe,
    className,
  ]}
>
  <h3 class:list={['text-2xl leading-tight font-bold tracking-tight', cores.titulo]}>{titulo}</h3>
  <p class="mt-3 text-sm leading-relaxed opacity-90"><slot /></p>
  <a
    href={href}
    class:list={[
      'mt-auto inline-flex items-center gap-1 pt-5 text-sm font-bold underline-offset-4 hover:underline after:absolute after:inset-0 after:rounded-cartao',
      cores.link,
    ]}
  >
    Saiba mais <span aria-hidden="true">→</span>
  </a>
</article>
