---
// Vídeo local. Sem src, mostra um bloco de "em breve" (placeholder da fase 1).
// Nenhum iframe de terceiros nesta fase: o vídeo real entra na fase 4, com carregamento só ao clicar.
interface Props {
  titulo: string;
  src?: string;
  poster?: string;
  legenda?: string;
}

const { titulo, src, poster, legenda } = Astro.props;
---

<figure class="w-full">
  {
    src ? (
      <video controls preload="none" poster={poster} class="aspect-video w-full rounded-cartao bg-surface" aria-label={titulo}>
        <source src={src} type="video/mp4" />
        Seu navegador não reproduz este vídeo.
      </video>
    ) : (
      <div
        role="img"
        aria-label={`${titulo}: vídeo em breve`}
        class="flex aspect-video w-full items-center justify-center rounded-cartao border border-border bg-surface text-ink-muted"
      >
        <span class="font-semibold">Vídeo em breve</span>
      </div>
    )
  }
  {legenda && <figcaption class="mt-3 text-sm text-ink-muted">{legenda}</figcaption>}
</figure>
