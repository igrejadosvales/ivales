---
import Container from './Container.astro';
import Button from './Button.astro';

interface Props {
  titulo: string;
  eyebrow?: string;
  texto?: string;
  imagem: { src: string; alt: string; width: number; height: number };
  cta?: { label: string; href: string };
}

const { titulo, eyebrow, texto, imagem, cta } = Astro.props;
---

<section class="bg-canvas py-secao text-ink lg:py-secao-lg">
  <Container class="grid items-center gap-10 lg:grid-cols-2">
    <div>
      {eyebrow && <p class="text-sm font-semibold tracking-wide text-accent-text uppercase">{eyebrow}</p>}
      <h1 class="mt-3 text-hero text-ink">{titulo}</h1>
      {texto && <p class="mt-6 max-w-prose text-lg text-ink-muted">{texto}</p>}
      {
        cta && (
          <div class="mt-8">
            <Button href={cta.href} variante="primario">
              {cta.label}
            </Button>
          </div>
        )
      }
    </div>
    <img
      src={imagem.src}
      alt={imagem.alt}
      width={imagem.width}
      height={imagem.height}
      fetchpriority="high"
      decoding="async"
      class="aspect-[4/3] w-full rounded-cartao object-cover"
    />
  </Container>
</section>
