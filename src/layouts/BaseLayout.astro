---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import fotoPadrao from '../assets/images/hero.jpg';
import { NOME_IGREJA, SITE_URL, schemaOrganizacao, schemaSite } from '../lib/igreja';

interface Props {
  title: string;
  description?: string;
  // Foto de src/assets: vira um JPG 1200×630 para Open Graph/WhatsApp. String = caminho já pronto em public/.
  socialImage?: ImageMetadata | string;
  noindex?: boolean;
  // Cabeçalho fixo e transparente sobre a imagem do topo (home).
  headerTransparente?: boolean;
  // Page without the site header and footer (e.g. the members area, which has its own back link).
  hideNavigation?: boolean;
  // JSON-LD extra da página (FAQPage, BreadcrumbList, ItemList...). O da organização e o do site já vão sempre.
  schema?: object[];
}

const {
  title,
  description = 'Igreja dos Vales em Gravataí e Porto Alegre: cultos aos domingos e quartas, iGrupos nas casas e ministérios.',
  socialImage = fotoPadrao,
  noindex = false,
  headerTransparente = false,
  hideNavigation = false,
  schema = [],
} = Astro.props;

const pageTitle = title.includes(NOME_IGREJA) ? title : `${title} | ${NOME_IGREJA}`;
// O canonical é sempre o domínio oficial, mesmo quando servido pelo *.vercel.app (que leva noindex no vercel.json).
const siteUrl = Astro.site ?? new URL(SITE_URL);
// Com build.format 'file' o pathname do build vem como /sobre.html (e /index.html na home): a URL pública é /sobre.
const caminho = Astro.url.pathname.replace(/(^|\/)index\.html$/, '/').replace(/\.html$/, '').replace(/(.)\/$/, '$1');
const canonicalUrl = new URL(caminho, siteUrl).toString();
const imagemSocial =
  typeof socialImage === 'string'
    ? socialImage
    : (await getImage({ src: socialImage, width: 1200, height: 630, fit: 'cover', format: 'jpeg', quality: 75 })).src;
const socialImageUrl = new URL(imagemSocial, siteUrl).toString();
const jsonLd = [schemaOrganizacao(), schemaSite(), ...schema];
---

<!doctype html>
<!-- class="light" e data-theme="light": a HeroUI usa só o tema claro. -->
<html lang="pt-BR" class="light" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Igreja dos Vales" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    {typeof socialImage !== 'string' && <meta property="og:image:width" content="1200" />}
    {typeof socialImage !== 'string' && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={NOME_IGREJA} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
    {jsonLd.map((dado) => <script type="application/ld+json" set:html={JSON.stringify(dado)} />)}
  </head>
  <body class="min-h-dvh bg-canvas font-sans text-ink antialiased">
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-canvas focus:px-4 focus:py-2 focus:font-semibold focus:text-ink focus:shadow-lg"
    >
      Pular para o conteúdo
    </a>
    {!hideNavigation && <Header transparente={headerTransparente} />}
    <main id="conteudo" tabindex="-1" class="outline-none">
      <slot />
    </main>
    {!hideNavigation && <Footer />}
  </body>
</html>
