---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import fotoHero from '../assets/images/ministerios-hero.png';
import fotoNext from '../assets/images/ministerios/next.png';
import fotoOutside from '../assets/images/ministerios.jpg';
import fotoEnraizadas from '../assets/images/ministerios/enraizadas.png';
import fotoForjados from '../assets/images/ministerios/forjados.png';
import { schemaBreadcrumb } from '../lib/igreja';
import HeroImersivo from '../components/ui/HeroImersivo.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';

// Fotos em src/assets (astro:assets). A do Outside ainda é provisória (foto geral de ministérios).
const ministerios = [
  {
    nome: 'Next',
    publico: 'Adolescentes',
    descricao: 'Um espaço para adolescentes crescerem na fé, construírem amizades e descobrirem seu propósito.',
    imagem: fotoNext,
    href: 'https://www.instagram.com/next.ivales/',
  },
  {
    nome: 'Outside',
    publico: 'Jovens',
    descricao: 'Uma comunidade de jovens para viver o evangelho, cultivar relacionamentos e impactar o mundo.',
    imagem: fotoOutside,
    href: 'https://www.instagram.com/outside.ivales/',
  },
  {
    nome: 'Enraizadas',
    publico: 'Mulheres',
    descricao: 'Mulheres fortalecidas em Deus, conectadas umas às outras e prontas para florescer em cada estação.',
    imagem: fotoEnraizadas,
    href: '/contato',
  },
  {
    nome: 'Forjados',
    publico: 'Homens',
    descricao: 'Homens sendo formados para liderar com fé, caráter e propósito dentro e fora da igreja.',
    imagem: fotoForjados,
    href: '/contato',
  },
] as const;
---

<BaseLayout
  title="Ministérios para jovens, mulheres e homens"
  description="Next (adolescentes), Outside (jovens), Enraizadas (mulheres) e Forjados (homens): conheça os ministérios da Igreja dos Vales em Gravataí e Porto Alegre."
  schema={[schemaBreadcrumb('Ministérios', '/ministerios')]}
  socialImage={fotoHero}
  headerTransparente
>
  <HeroImersivo
    eyebrow="Encontre seu lugar"
    titulo="Existe um lugar para você servir."
    texto="Cada pessoa tem dons, histórias e talentos que podem abençoar outras vidas. Conheça nossas áreas e caminhe com a gente."
    alinhamento="centro"
    imagem={{
      src: fotoHero,
      alt: 'Homem falando ao microfone em um encontro da Igreja dos Vales',
    }}
  >
    <Button href="#ministerios">Conheça os ministérios</Button>
  </HeroImersivo>

  <Section
    id="ministerios"
    titulo="Conheça nossos ministérios"
    eyebrow="Ministérios da Igreja dos Vales"
    subtitulo="Encontre seu lugar para servir."
    tom="elevado"
  >
    <div class="grid gap-6 md:grid-cols-2">
      {
        ministerios.map((ministerio, indice) => (
          <article
            class="ministerio-card group relative flex h-full min-h-[420px] flex-col overflow-hidden rounded-[1.25rem] border border-border bg-[#1a1a1a] text-left text-white shadow-sm transition-all duration-300 hover:-translate-y-2 hover:border-accent/50 hover:shadow-xl motion-reduce:transition-none"
            style={`--card-delay: ${indice * 120}ms`}
          >
            <Picture
              src={ministerio.imagem}
              alt={`Ministério ${ministerio.nome} da Igreja dos Vales, para ${ministerio.publico.toLowerCase()}`}
              widths={[480, 720, 960]}
              sizes="(min-width: 768px) 50vw, 100vw"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              quality={70}
              loading="lazy"
              decoding="async"
              class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none"
            />
            <div
              class="absolute inset-x-0 bottom-0 h-3/4 bg-gradient-to-t from-[#1a1a1a] via-[#1a1a1a]/75 to-transparent"
              aria-hidden="true"
            ></div>
            <div class="relative z-10 mt-auto flex flex-1 flex-col justify-end px-6 pb-6 pt-40 sm:px-7">
              <p class="text-sm font-semibold tracking-wide text-white/75 uppercase">{ministerio.publico}</p>
              <h3 class="mt-2 text-2xl font-bold text-white sm:text-3xl">{ministerio.nome}</h3>
              <p class="mt-3 text-base leading-5 text-white/80">{ministerio.descricao}</p>
              <a
                href={ministerio.href}
                target={ministerio.href.startsWith('http') ? '_blank' : undefined}
                rel={ministerio.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="mt-6 inline-flex items-center gap-2 self-start rounded-xl bg-white/15 px-5 py-3 font-bold text-white transition-colors hover:bg-white/25 hover:underline"
              >
                Saiba mais <span aria-hidden="true">{ministerio.href.startsWith('http') ? '↗' : '→'}</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="proximos-passos" titulo="Quer fazer parte?" eyebrow="Próximos passos" alinhamento="centro">
    <p class="mx-auto max-w-2xl text-lg text-ink-muted">
      Conte um pouco sobre você e indique as áreas que despertam seu interesse. Nossa equipe vai entrar em contato para ajudar você a começar.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href="/voluntariado">Quero servir</Button>
      <Button href="/contato" variante="secundario">Fale com a gente</Button>
    </div>
  </Section>
</BaseLayout>
