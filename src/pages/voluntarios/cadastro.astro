---
// Volunteer sign-up: full screen like the members area (no site header/footer, own back link).
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormularioVoluntariado from '../../components/islands/FormularioVoluntariado';
import { WHATSAPP_VOLUNTARIADO } from '../../lib/voluntariado';

// Built on the server so the island's JS carries no literal external URL.
const whatsappBase = `https://wa.me/${WHATSAPP_VOLUNTARIADO}`;
---

<BaseLayout
  title="Quero ser voluntário"
  description="Cadastro de voluntários da Igreja dos Vales: conte como quer servir e conecte-se à liderança."
  noindex
  hideNavigation
>
  <section
    id="cadastro"
    data-tom="elevado"
    aria-labelledby="cadastro-titulo"
    class="flex min-h-dvh w-full flex-col bg-surface text-ink"
  >
    <!-- No header or footer: this link is the way back. -->
    <div class="px-4 pt-4 sm:px-6 lg:px-8">
      <a
        href="/voluntarios"
        class="inline-flex min-h-10 items-center gap-2 rounded-full border border-border bg-canvas px-4 text-sm font-semibold text-ink shadow-sm transition-colors hover:border-border-strong"
      >
        <span aria-hidden="true">←</span>
        Voltar
      </a>
    </div>

    <div class="flex w-full flex-1 flex-col px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
      <div class="text-center">
        <p class="text-sm font-semibold tracking-wide text-accent-text uppercase">Cadastro</p>
        <h1 id="cadastro-titulo" class="mt-2 text-titulo text-ink">Quero ser voluntário</h1>
        <p class="mt-3 text-lg text-ink-muted">Responda algumas perguntas e conecte-se à liderança.</p>
      </div>

      <div class="mt-8 w-full">
        <noscript>
          <p class="mb-4 rounded-cartao bg-canvas p-4 text-sm text-ink-muted">
            O cadastro em etapas precisa de JavaScript. Se preferir, fale com a liderança pelo WhatsApp:
            <a href={whatsappBase} class="font-semibold text-accent-text underline underline-offset-4">
              (51) 99394-3907
            </a>.
          </p>
        </noscript>
        <FormularioVoluntariado client:load whatsappBase={whatsappBase} />
      </div>
    </div>
  </section>
</BaseLayout>
