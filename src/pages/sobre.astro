---
import BaseLayout from '../layouts/BaseLayout.astro';
import fotoHero from '../assets/images/sobre-hero.png';
import { schemaBreadcrumb } from '../lib/igreja';
import HeroImersivo from '../components/ui/HeroImersivo.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';

// Texto-base escrito a partir do que o site já diz (igreja família, cultos, iGrupos e ministérios).
// Revisar com a liderança antes de tratar como declaração oficial.
const identidade = [
  {
    titulo: 'Nossa Visão',
    texto: 'Ser uma igreja família que acolhe, forma discípulos de Jesus e transforma os Vales por meio de vidas curadas e comunidades vivas.',
  },
  {
    titulo: 'Nossa Missão',
    texto: 'Levar o evangelho de Jesus a todas as pessoas, conectando cada uma a um lugar para pertencer, crescer na fé e servir.',
  },
  {
    titulo: 'Nossos Valores',
    texto: 'Jesus no centro, a Bíblia como base, família e comunhão, simplicidade, generosidade, excelência no servir e fé que se vive no dia a dia.',
  },
  {
    titulo: 'Nossos Propósitos',
    texto: 'Missões, Adoração, Comunhão, Serviço e Discipulado: é assim que vivemos a fé nos cultos, nos iGrupos e nos ministérios.',
  },
];
---

<BaseLayout
  title="Quem somos: visão, missão e valores"
  description="Conheça a Igreja dos Vales, igreja família em Gravataí e Porto Alegre: quem somos, nossa visão, missão, valores e propósitos."
  schema={[schemaBreadcrumb('Sobre', '/sobre')]}
  socialImage={fotoHero}
  headerTransparente
>
  <HeroImersivo
    eyebrow="Bem-vindo"
    titulo="Nós somos a Igreja dos Vales!"
    texto="Uma família para você pertencer. Conheça quem somos, nossos valores e o que cremos."
    alinhamento="centro"
    imagem={{
      src: fotoHero,
      alt: 'Duas pessoas apresentando uma programação durante um encontro da Igreja dos Vales',
    }}
  >
    <Button href="#identidade">Conheça quem somos</Button>
  </HeroImersivo>

  <Section tom="escuro" class="bg-black">
    <p class="max-w-4xl text-titulo leading-tight font-medium text-ink">
      Somos uma igreja família: um lugar para pertencer, crescer em Cristo e servir. Por meio dos cultos, iGrupos e
      ministérios, você tem um lugar aqui.
    </p>
  </Section>

  <Section id="identidade" titulo="Quem somos" eyebrow="Nossa identidade" alinhamento="centro" tom="elevado">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {identidade.map((item) => (
        <Card titulo={item.titulo} class="border-0 bg-transparent p-0 hover:border-0">
          {item.texto}
        </Card>
      ))}
    </div>
  </Section>

  <Section id="envolva-se" titulo="Vem fazer parte da família!" tom="destaque">
    <p class="max-w-prose text-lg">Veja como Deus pode usar seus dons para um impacto eterno!</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <Button href="/voluntarios" variante="primario">Seja um voluntário</Button>
      <Button href="/contato" variante="secundario">Fale com a gente</Button>
    </div>
  </Section>
</BaseLayout>
