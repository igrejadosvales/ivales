---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Button from '../components/ui/Button.astro';
import IgruposExplorer from '../components/islands/igrupos/IgruposExplorer';
import { IGRUPOS, localDoGrupo, quandoReune } from '../lib/igrupos';
import { schemaBreadcrumb } from '../lib/igreja';

// Lista dos grupos para o Google. Só nome, bairro, cidade e quando: sem rua nem telefone dos líderes.
const schemaIgrupos = () => ({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'iGrupos da Igreja dos Vales',
  numberOfItems: IGRUPOS.length,
  itemListElement: IGRUPOS.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `iGrupo ${g.nome}`,
    description: `${g.perfil} · ${localDoGrupo(g)} · ${quandoReune(g)}`,
  })),
});
---

<BaseLayout
  title="iGrupos: pequenos grupos nas casas"
  description="Encontre um iGrupo perto de você em Porto Alegre, Canoas, Alvorada ou Glorinha: busque por bairro, perfil e dia e fale com os líderes no WhatsApp."
  schema={[schemaBreadcrumb('iGrupos', '/igrupos'), schemaIgrupos()]}
>
  <section class="bg-canvas pt-20 pb-6 lg:pt-24">
    <h1 class="hero-entrada hero-entrada-1 px-4 text-center text-hero text-ink sm:px-6 lg:px-8">iGrupos</h1>
    <p class="hero-entrada hero-entrada-2 mx-auto mt-4 max-w-2xl px-4 text-center text-lg text-ink-muted sm:px-6 lg:px-8">
      Pequenos grupos que se reúnem nas casas durante a semana. Encontre um perto de você e chame os líderes no WhatsApp.
    </p>
  </section>

  <section id="explorar" aria-label="Encontrar um iGrupo" class="scroll-mt-20 bg-canvas">
    <div class="w-full">
      <IgruposExplorer client:only="react" />
      <noscript>
        <p class="rounded-xl border border-border bg-surface p-4 text-sm text-ink-muted">
          O mapa e a busca precisam de JavaScript. Veja a lista completa abaixo e chame a gente em <a class="font-bold text-accent-text underline" href="/contato">Contato</a> para falar com os líderes.
        </p>
        <ul class="mt-4 grid gap-3 md:grid-cols-2">
          {
            IGRUPOS.map((g) => (
              <li class="rounded-xl border border-border bg-canvas p-4">
                <p class="text-xs font-bold tracking-wide text-accent-text uppercase">{g.perfil} · {localDoGrupo(g)}</p>
                <p class="mt-1 text-lg font-bold text-ink">{g.nome}</p>
                <p class="text-sm text-ink-muted">{quandoReune(g)}</p>
                <p class="text-sm text-ink-muted">{g.endereco}</p>
              </li>
            ))
          }
        </ul>
      </noscript>
    </div>
  </section>

  <Section
    id="nao-achou"
    tom="elevado"
    alinhamento="centro"
    eyebrow="Não achou um grupo perto?"
    titulo="A gente te ajuda a encontrar"
    subtitulo="Conte onde você mora e qual dia fica melhor. Se ainda não há um iGrupo na sua região, vamos caminhar com você para abrir um."
  >
    <div class="flex justify-center">
      <Button href="/contato">Falar com a equipe</Button>
    </div>
  </Section>
</BaseLayout>
